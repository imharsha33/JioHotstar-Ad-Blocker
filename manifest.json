{
  "manifest_version": 3,
  "name": "Jio Hotstar Ad Blocker",
  "short_name": "Hotstar Blocker",
  "version": "1.0.0",
  "description": "Skips detectable JioHotstar video ads and hides common sponsored ad spaces. Local-only, with no analytics.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hotstar.com/*",
    "https://*.hotstar.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jio Hotstar Ad Blocker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hotstar.com/*",
        "https://*.hotstar.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://hotstar.com/*",
        "https://*.hotstar.com/*"
      ],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
